# SPDT environment configuration — copy to .env and fill in. NEVER commit .env.
# Everything has a safe default: with nothing set, the desk runs synthetic + paper.

# --- data source -----------------------------------------------------------------
SPDT_LIVE=false                 # true → fetch live market data instead of synthetic
SPDT_SOURCE=bhavcopy            # bhavcopy (EOD, free) | dhan (intraday) | xts (broker feed)

# --- XTS broker API (AC Agarwal / Symphony) ---------------------------------------
SPDT_XTS_BASE_URL=              # e.g. https://<broker-host>/apimarketdata
SPDT_XTS_MARKETDATA_APP_KEY=
SPDT_XTS_MARKETDATA_SECRET=
SPDT_XTS_INTERACTIVE_APP_KEY=    # optional: read-only broker state (Broker tab)
SPDT_XTS_INTERACTIVE_SECRET=

# --- DhanHQ (alternative intraday source) -----------------------------------------
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- execution safety gates (defaults are the safest possible) ---------------------
SPDT_EXECUTION_MODE=paper       # paper | read_only | live — live orders need "live" AND the flag below
SPDT_LIVE_TRADING=false         # both must be set deliberately before any real order
SPDT_KILL_SWITCH=false          # true blocks all live orders regardless of anything else
SPDT_MAX_ORDER_NOTIONAL=        # required (INR) before live mode will accept any order
SPDT_ALLOWED_INSTRUMENTS=       # comma-separated SEGMENT:ID, e.g. NSEFO:101,NSEFO:26000

# --- desk service ------------------------------------------------------------------
SPDT_DESK_TTL=60                # desk re-marks in the background when older than this; requests never block
SPDT_API_TOKEN=                 # when set, compute endpoints require X-API-Token header
SPDT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPDT_DELTA_LIMIT=1000000        # greek-limit alert thresholds
SPDT_VEGA_LIMIT=500000
SPDT_QUOTE_MAX_AGE_S=           # hedge-execution staleness gate (default in code)
SPDT_QUOTE_MAX_FUTURE_SKEW=     # tolerated clock skew on quote timestamps
SPDT_RECOMMENDATION_TTL_S=      # how long a hedge recommendation stays executable

# --- optional data overlays ---------------------------------------------------------
SPDT_BLOOMBERG_RATES_XLSX=      # path to a Bloomberg MIFOR export for the funding overlay
